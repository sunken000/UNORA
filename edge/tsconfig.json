{
  "compilerOptions": {
    "target": "ES2022",
    // Wrangler generates the Worker runtime globals in worker-configuration.d.ts.
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true
  },
  "include": ["src/**/*.ts", "worker-configuration.d.ts"]
}
