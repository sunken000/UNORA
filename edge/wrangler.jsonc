{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "unora-edge",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-09",
  "durable_objects": {
    "bindings": [
      { "name": "PARTY_ROOM", "class_name": "PartyRoom" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["PartyRoom"] }
  ],
  "vars": {
    "MAX_PARTY_SIZE": "8",
    "ENABLE_TURN": "false",
    "TURN_TTL_SECONDS": "3600",
    // Set to the web application origin if browser clients are introduced.
    // Android clients do not rely on CORS.
    "ALLOWED_ORIGIN": ""
  }
}
